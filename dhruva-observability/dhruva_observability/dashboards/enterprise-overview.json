{
  "dashboard": {
    "id": null,
    "title": "Dhruva Enterprise Observability",
    "tags": ["dhruva", "enterprise", "observability"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(dhruva_enterprise_requests_total[5m])",
            "legendFormat": "{{customer}}/{{app}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Time",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(dhruva_enterprise_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(dhruva_enterprise_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "System Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "dhruva_enterprise_system_uptime_percent",
            "legendFormat": "{{time_window}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Service Usage by Customer",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (customer) (rate(dhruva_enterprise_service_requests_total[1h]))",
            "legendFormat": "{{customer}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Component Latency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(dhruva_enterprise_component_latency_seconds_bucket[5m]))",
            "legendFormat": "{{component}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Data Processing Volume",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(dhruva_enterprise_data_processed_total[1h])",
            "legendFormat": "{{data_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Resource Utilization",
        "type": "timeseries",
        "targets": [
          {
            "expr": "dhruva_enterprise_cpu_usage_percent",
            "legendFormat": "CPU {{service}}"
          },
          {
            "expr": "dhruva_enterprise_memory_usage_percent",
            "legendFormat": "Memory {{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
      },
      {
        "id": 9,
        "title": "SLA Compliance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "dhruva_enterprise_system_sla_compliance_percent",
            "legendFormat": "{{sla_type}} - {{customer}}/{{app}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
